# ── Google Sheets (Service Account) ────────────────────────────────────────
# Path to your downloaded service_account.json file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The long ID from your Google Sheet URL:  /spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Get from: platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=sk-...

# Model to use for job scoring (gpt-4o-mini is cheapest / fast)
OPENAI_MODEL=gpt-4o-mini

# ── Decodo Scraper API ───────────────────────────────────────────────────────
# Get from: app.decodo.com → Scraping API → API Key
DECODO_API_KEY=your_decodo_api_key_here

# Which job board to scrape (RemoteOK JSON API is free & reliable)
JOB_SOURCE_URL=https://remoteok.com/api

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# Your Gmail address (used to send)
GMAIL_SENDER=you@gmail.com

# Gmail App Password (NOT your regular password):
#   Google Account → Security → 2-Step Verification → App passwords → Mail
#   Result is a 16-character code like: abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where to deliver the daily summary (can be same as GMAIL_SENDER)
GMAIL_RECIPIENT=you@gmail.com

# ── Workflow tuning ──────────────────────────────────────────────────────────
# Minimum fit_score to include a job in results (0-100)
# 60 = strict (high quality only)
# 50 = balanced
# 40 = default
# 30 = high volume
FIT_SCORE_THRESHOLD=40

# Max jobs to score per run (controls OpenAI API cost)
MAX_JOBS_PER_RUN=30
